// Bread & Basket: database schema (2-week MVP)
// Every campaign serves all active locations; no per-campaign location table.

// ===== ENUMS =====
Enum user_role {
  admin
  seller
  consumer
}

Enum approval_status {
  pending
  approved
  rejected
}

Enum product_source {
  seller
  platform
}

Enum campaign_status {
  draft
  active
  successful
  failed
  fulfilling
  completed
  cancelled
}

Enum fulfilment_type {
  delivery
  collection
}

Enum order_status {
  paid
  confirmed
  preparing
  dispatched
  ready_for_collection
  completed
  cancelled
  refunded
}

Enum payment_status {
  successful
  refunded
}

Enum refund_reason {
  consumer_cancelled
  campaign_failed
}

Enum settlement_status {
  pending
  paid
}

// ===== TABLES =====
Table users {
  id int [pk, increment]
  full_name varchar(120) [not null]
  email varchar(120) [unique, not null]
  phone varchar(20)
  password_hash varchar(255) [not null]
  role user_role [not null]
  is_active boolean [default: true]
  created_at timestamp [default: `now()`]
}

Table seller_profiles {
  id int [pk, increment]
  user_id int [unique, not null, ref: - users.id]
  business_name varchar(150) [not null]
  registration_number varchar(60)
  business_address varchar(255)
  verification_status approval_status [default: 'pending']
  rejection_reason varchar(255)
  reviewed_by int [ref: > users.id, note: 'admin who reviewed']
  reviewed_at timestamp
  created_at timestamp [default: `now()`]
}

Table products {
  id int [pk, increment]
  seller_id int [ref: > seller_profiles.id, note: 'null when platform-sourced']
  source product_source [not null]
  name varchar(150) [not null]
  description text
  category varchar(40) [note: 'e.g. Flour, Oil, Vegetables']
  unit varchar(40) [not null, note: 'e.g. 1kg, 2L bottle']
  image_url varchar(255)
  wholesale_price decimal(10,2) [not null]
  retail_price decimal(10,2) [not null, note: 'used for savings comparison']
  stock_quantity int [default: 0]
  approval_status approval_status [default: 'pending']
  rejection_reason varchar(255)
  reviewed_by int [ref: > users.id]
  reviewed_at timestamp
  created_at timestamp [default: `now()`]
}

Table locations {
  id int [pk, increment]
  name varchar(100) [unique, not null, note: 'e.g. Kasarani, Westlands']
  delivery_fee decimal(10,2) [not null, default: 0, note: 'flat fee per order for delivery to this area']
  collection_point varchar(150) [note: 'where shoppers collect in this area, e.g. Gikomba depot']
  is_active boolean [default: true, note: 'inactive areas disappear from checkout']
}

Table campaigns {
  id int [pk, increment]
  product_id int [not null, ref: > products.id]
  created_by int [not null, ref: > users.id, note: 'admin']
  title varchar(150) [not null]
  campaign_price decimal(10,2) [not null, note: 'copied from product wholesale_price at creation']
  platform_charge decimal(10,2) [default: 0, note: 'per unit']
  min_quantity int [not null, note: 'campaign succeeds if reached by deadline']
  max_quantity int [not null, note: 'seller stock; closes to new orders when full']
  min_order_quantity int [default: 1, note: 'smallest order allowed']
  max_per_user int [note: 'optional cap per person across all their orders in this campaign']
  deadline timestamp [not null]
  cancellation_cutoff timestamp [not null, note: 'default: deadline minus 3 days']
  status campaign_status [default: 'draft']
  closed_at timestamp
  stock_confirmed_at timestamp [note: 'seller confirms stock']
  created_at timestamp [default: `now()`]
}

Table orders {
  id int [pk, increment]
  order_no varchar(30) [unique, not null]
  campaign_id int [not null, ref: > campaigns.id]
  consumer_id int [not null, ref: > users.id]
  quantity int [not null]
  unit_price decimal(10,2) [not null, note: 'snapshot']
  platform_charge decimal(10,2) [default: 0, note: 'snapshot, per unit']
  logistics_charge decimal(10,2) [default: 0, note: 'snapshot, flat per order; 0 for collection']
  total_amount decimal(10,2) [not null, note: 'quantity x (unit_price + platform_charge) + logistics_charge']
  fulfilment fulfilment_type [not null]
  location_id int [not null, ref: > locations.id, note: 'delivery area or collection area']
  delivery_address varchar(255) [note: 'street address, delivery only']
  status order_status [default: 'paid']
  cancelled_at timestamp
  created_at timestamp [default: `now()`]
}

Table payments {
  id int [pk, increment]
  order_id int [not null, ref: - orders.id]
  amount decimal(10,2) [not null]
  method varchar(30) [default: 'simulated_mpesa']
  reference varchar(60)
  status payment_status [default: 'successful']
  paid_at timestamp [default: `now()`]
}

Table refunds {
  id int [pk, increment]
  payment_id int [not null, unique, ref: - payments.id]
  order_id int [not null, ref: > orders.id]
  amount decimal(10,2) [not null]
  reason refund_reason [not null]
  processed_by int [ref: > users.id, note: 'null when automatic']
  processed_at timestamp [default: `now()`]
}

Table order_status_history {
  id int [pk, increment]
  order_id int [not null, ref: > orders.id]
  status order_status [not null]
  note varchar(255)
  updated_by int [ref: > users.id]
  created_at timestamp [default: `now()`]
}

Table settlements {
  id int [pk, increment]
  seller_id int [not null, ref: > seller_profiles.id]
  campaign_id int [not null, ref: > campaigns.id]
  amount decimal(10,2) [not null]
  status settlement_status [default: 'pending']
  settled_at timestamp
  indexes {
  (seller_id, campaign_id) [unique]
}
}

Table notifications {
  id int [pk, increment]
  user_id int [not null, ref: > users.id]
  message varchar(255) [not null]
  is_read boolean [default: false]
  created_at timestamp [default: `now()`]
}
